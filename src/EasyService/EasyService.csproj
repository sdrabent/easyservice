<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>easyservice</AssemblyName>
    <RootNamespace>EasyService</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\easyservice.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Product>EasyService</Product>
    <Company>EasyService Contributors</Company>
    <Copyright>Copyright (c) EasyService Contributors</Copyright>
    <Description>GUI service manager and process supervisor for Windows</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="easyservice-tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\easyservice.ico" LogicalName="EasyService.AppIcon.ico" />
  </ItemGroup>

</Project>
