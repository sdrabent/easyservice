<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Konsolenprogramm, nicht WinExe. Auf ein Windows-Subsystem-Programm wartet weder
         cmd noch PowerShell: der Rueckgabewert kommt nie in %ERRORLEVEL% oder
         $LASTEXITCODE an, und ein Skript kann nicht pruefen, ob der Dienst wirklich
         angelegt wurde. Die Oberflaeche gibt ihre Konsole beim Start wieder frei. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>easyservice</AssemblyName>
    <RootNamespace>EasyService</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\easyservice.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Nur der Rueckfall fuer lokale Builds. Die CI setzt -p:Version aus dem Git-Tag,
         damit ein Binary nicht behauptet, 1.0.0 zu sein, wenn es aus v1.4.2 stammt. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>EasyService</Product>
    <Company>EasyService Contributors</Company>
    <Copyright>Copyright (c) EasyService Contributors</Copyright>
    <Description>GUI service manager and process supervisor for Windows</Description>
    <!-- Volle Kulturdaten: ohne sie liefert CultureInfo("de") die invariante Kultur
         zurueck und die Uebersetzung wuerde nie greifen. Maschinenlesbare Ausgaben
         (Perfdata, Prometheus, JSON) formatieren deshalb explizit invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <!-- Application.SetColorMode ist in .NET 9 noch als experimentell markiert. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="easyservice-tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\easyservice.ico" LogicalName="EasyService.AppIcon.ico" />
  </ItemGroup>

</Project>
